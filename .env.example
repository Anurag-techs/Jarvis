# ==============================================================================
# JARVIS AI Assistant Environment Configuration Example
# Copy this file to .env and customize for your local setup.
# ==============================================================================

# Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Assistant Configuration
ASSISTANT_NAME=JARVIS
WAKE_WORD=jarvis

# Weather & News Service Configuration
WEATHER_API_KEY=
NEWS_API_KEY=

# LLM Provider Configuration (Version 1.0 Default: Mock / Local Interface)
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_API_KEY=

# Voice & Speech Configuration
STT_ENGINE=mock
TTS_ENGINE=mock
