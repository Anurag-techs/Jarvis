# JARVIS Environment Configuration Example

# Application Settings
ENV=development
LOG_LEVEL=INFO
ASSISTANT_NAME=JARVIS

# AI LLM Provider Configuration (Sprint 3)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Voice Configuration (Milestone 3 & 4)
VOICE_MODE=false
WAKE_WORD=hey jarvis
STT_PROVIDER=faster_whisper
WHISPER_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Voice Engine Settings
VOICE_PROVIDER=pyttsx3
VOICE_RATE=200
VOICE_VOLUME=1.0
VOICE_ID=

# Wake-Word & Voice Pipeline Settings (Milestone 4 & 4.5)
WAKEWORD_PROVIDER=openwakeword
WAKEWORD_SENSITIVITY=0.5
LISTEN_TIMEOUT=8
POST_RESPONSE_TIMEOUT=5
VOICE_COOLDOWN_SECONDS=1.0
