# ==============================================================================
# JARVIS AI Assistant Environment Configuration Example
# Copy this file to .env and customize for your local setup.
# ==============================================================================

# Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Assistant Configuration
ASSISTANT_NAME=JARVIS
WAKE_WORD=jarvis

# Weather & News Service Configuration
WEATHER_API_KEY=
NEWS_API_KEY=

# LLM Provider Configuration (Options: "mock", "gemini")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Voice & Speech Configuration
VOICE_PROVIDER=pyttsx3
VOICE_RATE=200
VOICE_VOLUME=1.0
VOICE_ID=
